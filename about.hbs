<!doctype html>
<html>
<head><meta charset="utf-8"><title>phoxite: Rust dependency licences</title></head>
<body>
<h1>Licences of the Rust crates phoxite is built from</h1>
{{#each licenses}}
<h2>{{name}}</h2>
<ul>{{#each used_by}}<li>{{crate.name}} {{crate.version}}</li>{{/each}}</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
