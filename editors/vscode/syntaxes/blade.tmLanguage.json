{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Blade",
  "scopeName": "text.html.php.blade",
  "comment": "Blade templates: HTML with Blade comments, echoes and directives whose arguments and @php blocks are PHP. Inside HTML tags, attribute values, scripts and styles the HTML grammar is in charge, so Blade is injected there. Written for phoxite (Apache-2.0).",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#php-block"
    },
    {
      "include": "#verbatim"
    },
    {
      "include": "#raw-echo"
    },
    {
      "include": "#echo"
    },
    {
      "include": "#escaped"
    },
    {
      "include": "#directive-with-arguments"
    },
    {
      "include": "#directive"
    },
    {
      "include": "text.html.php"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.blade",
      "begin": "\\{\\{--",
      "end": "--\\}\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.comment.begin.blade"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.comment.end.blade"
        }
      }
    },
    "php-block": {
      "name": "meta.embedded.block.php.blade",
      "contentName": "source.php",
      "begin": "(?<![\\w@])(@php)(?!\\s*\\()",
      "end": "(@endphp)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.directive.blade"
        }
      },
      "endCaptures": {
        "1": {
          "name": "keyword.control.directive.blade"
        }
      },
      "patterns": [
        {
          "include": "source.php"
        }
      ]
    },
    "verbatim": {
      "begin": "(?<![\\w@])(@verbatim)\\b",
      "end": "(@endverbatim)\\b",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.directive.blade"
        }
      },
      "endCaptures": {
        "1": {
          "name": "keyword.control.directive.blade"
        }
      },
      "patterns": [
        {
          "include": "text.html.basic"
        }
      ]
    },
    "escaped": {
      "comment": "@{{ … }} and @@directive print as written.",
      "name": "constant.character.escape.blade",
      "match": "@(\\{\\{|@\\w+)"
    },
    "raw-echo": {
      "name": "meta.embedded.line.php.blade",
      "contentName": "source.php",
      "begin": "\\{!!",
      "end": "!!\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.blade"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.blade"
        }
      },
      "patterns": [
        {
          "include": "source.php"
        }
      ]
    },
    "echo": {
      "name": "meta.embedded.line.php.blade",
      "contentName": "source.php",
      "begin": "(?<!@)\\{\\{",
      "end": "\\}\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.blade"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.blade"
        }
      },
      "patterns": [
        {
          "include": "source.php"
        }
      ]
    },
    "directive-with-arguments": {
      "begin": "(?<![\\w@])(@\\w+)\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.directive.blade"
        },
        "2": {
          "name": "punctuation.definition.arguments.begin.blade"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.arguments.end.blade"
        }
      },
      "contentName": "source.php",
      "patterns": [
        {
          "include": "#parentheses"
        },
        {
          "include": "source.php"
        }
      ]
    },
    "parentheses": {
      "begin": "\\(",
      "end": "\\)",
      "patterns": [
        {
          "include": "#parentheses"
        },
        {
          "include": "source.php"
        }
      ]
    },
    "directive": {
      "name": "keyword.control.directive.blade",
      "match": "(?<![\\w@])@\\w+"
    },
    "bound-attribute": {
      "comment": "A component's bound attribute: `:type=\"$type\"` is PHP. `::class` (escaped) is not.",
      "patterns": [
        {
          "begin": "(?<=\\s)(:[\\w.-]+)(=)(\")",
          "end": "\"",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.bound.blade"
            },
            "2": {
              "name": "punctuation.separator.key-value.html"
            },
            "3": {
              "name": "string.quoted.double.html punctuation.definition.string.begin.html"
            }
          },
          "endCaptures": {
            "0": {
              "name": "string.quoted.double.html punctuation.definition.string.end.html"
            }
          },
          "name": "meta.attribute.bound.blade",
          "contentName": "meta.embedded.line.php.blade source.php",
          "patterns": [
            {
              "include": "source.php"
            }
          ]
        },
        {
          "begin": "(?<=\\s)(:[\\w.-]+)(=)(')",
          "end": "'",
          "beginCaptures": {
            "1": {
              "name": "entity.other.attribute-name.bound.blade"
            },
            "2": {
              "name": "punctuation.separator.key-value.html"
            },
            "3": {
              "name": "string.quoted.single.html punctuation.definition.string.begin.html"
            }
          },
          "endCaptures": {
            "0": {
              "name": "string.quoted.single.html punctuation.definition.string.end.html"
            }
          },
          "name": "meta.attribute.bound.blade",
          "contentName": "meta.embedded.line.php.blade source.php",
          "patterns": [
            {
              "include": "source.php"
            }
          ]
        }
      ]
    }
  },
  "injections": {
    "L:text.html.php.blade meta.tag - (comment.block.blade | meta.embedded.line.php.blade | meta.embedded.block.php.blade | source.php)": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#raw-echo"
        },
        {
          "include": "#echo"
        },
        {
          "include": "#escaped"
        },
        {
          "include": "#bound-attribute"
        },
        {
          "include": "#directive-with-arguments"
        },
        {
          "include": "#directive"
        }
      ]
    },
    "L:text.html.php.blade source.js - (comment.block.blade | meta.embedded.line.php.blade | meta.embedded.block.php.blade | source.php), L:text.html.php.blade source.css - (comment.block.blade | meta.embedded.line.php.blade | meta.embedded.block.php.blade | source.php)": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#raw-echo"
        },
        {
          "include": "#echo"
        },
        {
          "include": "#escaped"
        }
      ]
    }
  }
}
