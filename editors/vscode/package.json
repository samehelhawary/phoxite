{
  "name": "phoxite",
  "displayName": "Phoxite — PHP & Laravel IntelliSense",
  "description": "PHP and Laravel code intelligence: completion, navigation, usages, rename, refactorings, formatting, inspections and Laravel support (routes, views, config, translations, validation, Eloquent, Blade, generators, Artisan).",
  "version": "0.1.0",
  "publisher": "phoxite",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/samehelhawary/phoxite"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "php",
    "laravel",
    "blade",
    "intellisense",
    "refactoring"
  ],
  "activationEvents": [
    "onLanguage:php",
    "onLanguage:blade",
    "workspaceContains:composer.json"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configurationDefaults": {
      "php.suggest.basic": false,
      "php.validate.enable": false
    },
    "languages": [
      {
        "id": "blade",
        "aliases": [
          "Blade",
          "blade"
        ],
        "extensions": [
          ".blade.php"
        ],
        "configuration": "./languages/blade.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "blade",
        "scopeName": "text.html.php.blade",
        "path": "./syntaxes/blade.tmLanguage.json",
        "embeddedLanguages": {
          "source.php": "php",
          "text.html.basic": "html",
          "source.css": "css",
          "source.js": "javascript"
        }
      }
    ],
    "commands": [
      {
        "command": "phoxite.restart",
        "title": "Restart the Language Server",
        "category": "Phoxite"
      },
      {
        "command": "phoxite.rescan",
        "title": "Index the Project Again",
        "category": "Phoxite"
      },
      {
        "command": "phoxite.showOutput",
        "title": "Show the Server Log",
        "category": "Phoxite"
      },
      {
        "command": "phoxite.laravel.generate",
        "title": "Generate…",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.newModel",
        "title": "New Eloquent Model…",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.modelView",
        "title": "Open Model View…",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.artisan",
        "title": "Run Artisan Command…",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.routes.goto",
        "title": "Go to Route…",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.routes.refresh",
        "title": "Refresh Routes",
        "category": "Laravel",
        "icon": "$(refresh)"
      },
      {
        "command": "phoxite.laravel.editTemplate",
        "title": "Edit Generator Template…",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.route.goto",
        "title": "Go to Declaration",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.route.copyUrl",
        "title": "Copy URL",
        "category": "Laravel",
        "icon": "$(link)"
      },
      {
        "command": "phoxite.laravel.route.open",
        "title": "Open in Browser",
        "category": "Laravel",
        "icon": "$(globe)"
      },
      {
        "command": "phoxite.laravel.route.copyRequest",
        "title": "Copy HTTP Request",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.modelView.findUsages",
        "title": "Find Usages",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.modelView.rename",
        "title": "Rename…",
        "category": "Laravel"
      }
    ],
    "configuration": {
      "title": "Phoxite",
      "properties": {
        "phoxite.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The `phoxite-lsp` executable. Empty: the one bundled with the extension."
        },
        "phoxite.phpVersion": {
          "type": "string",
          "default": "",
          "markdownDescription": "The PHP version the code is checked against, e.g. `8.3`. Empty: from `composer.json` (`config.platform.php`, else the lowest version `require.php` allows), else the latest."
        },
        "phoxite.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Folders outside the project whose code is indexed too: absolute, `~/…`, or relative to the project."
        },
        "phoxite.stubs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra phpstorm-stubs sets (`redis`, `swoole`, `wordpress`…) on top of the defaults and the `ext-*` requirements of `composer.json`."
        },
        "phoxite.exclude": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null,
          "markdownDescription": "Globs of files and folders left out of the index (`node_modules`, `/storage`). `null`: `node_modules`, `.git`, `storage/framework` and `bootstrap/cache`. `vendor` is read through Composer's `installed.json` either way."
        },
        "phoxite.inspections": {
          "type": "object",
          "default": {},
          "markdownDescription": "Per-inspection settings by id, e.g. `{ \"PhpUndefinedMethod\": { \"enabled\": false }, \"PhpTypeMismatch\": { \"strict\": true, \"severity\": \"error\" } }`. The key `*` with `enabled: false` turns every inspection off.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "strict": {
                "type": "boolean",
                "description": "Type and call checks: also report what can't be proven."
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning",
                  "information",
                  "hint"
                ]
              }
            }
          }
        },
        "phoxite.laravel.detection": {
          "type": "string",
          "enum": [
            "auto",
            "enabled",
            "disabled"
          ],
          "default": "auto",
          "markdownDescription": "Laravel support: `auto` when `composer.json` requires `laravel/framework`, the lock file lists it, or `artisan` exists."
        },
        "phoxite.laravel.routeHints": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Code lenses on controller methods listing their routes, and the full URI after each route registration."
        },
        "phoxite.laravel.modules": {
          "type": "string",
          "enum": [
            "auto",
            "nwidart",
            "directory",
            "none"
          ],
          "default": "auto",
          "markdownDescription": "Which modules of a modular application are read: `nwidart/laravel-modules`, module folders (`modules/`, `app-modules/`…), both (`auto`), or none."
        },
        "phoxite.laravel.inertiaPages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Folders of Inertia pages, relative to the project. Empty: the `ide.json` page paths, else `resources/js/Pages`."
        },
        "phoxite.laravel.artisanCommand": {
          "type": "string",
          "default": "php artisan",
          "scope": "resource",
          "markdownDescription": "How Artisan commands are run from the project folder, e.g. `php artisan`, `./vendor/bin/sail artisan` or `docker compose exec app php artisan`."
        },
        "phoxite.laravel.generation.namespace": {
          "type": "string",
          "default": "",
          "markdownDescription": "The application's root namespace for generated classes. Empty: the one `composer.json` maps to `app/`."
        },
        "phoxite.laravel.generation.module": {
          "type": "string",
          "default": "",
          "markdownDescription": "The module generated classes go to. Empty: the application."
        },
        "phoxite.laravel.generation.controllerSuffix": {
          "type": "string",
          "default": "Controller",
          "markdownDescription": "The suffix of generated controller classes."
        },
        "phoxite.laravel.generation.requestSuffix": {
          "type": "string",
          "default": "Request",
          "markdownDescription": "The suffix of generated request classes."
        },
        "phoxite.laravel.generation.resourceSuffix": {
          "type": "string",
          "default": "Resource",
          "markdownDescription": "The suffix of generated resource classes."
        },
        "phoxite.laravel.generation.policySuffix": {
          "type": "string",
          "default": "Policy",
          "markdownDescription": "The suffix of generated policy classes."
        },
        "phoxite.laravel.generation.seederSuffix": {
          "type": "string",
          "default": "Seeder",
          "markdownDescription": "The suffix of generated seeder classes."
        },
        "phoxite.laravel.generation.constructorPromotion": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Generated constructors promote their parameters to properties."
        },
        "phoxite.laravel.generation.typeHints": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Generated methods declare their return types."
        },
        "phoxite.format.lineWidth": {
          "type": "number",
          "default": 120,
          "minimum": 40,
          "markdownDescription": "The line length Format Document tries to stay within."
        },
        "phoxite.templates.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "The folder of the generator templates you edited (**Laravel: Edit Generator Template…**), relative to the project. Empty: `.phoxite/templates`."
        },
        "phoxite.warnAboutOtherServers": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Warn when another PHP language server (Intelephense, PHP Intelephense, Phpactor) is active too: both would answer every request."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "phoxite.laravel.routes",
          "name": "Laravel Routes",
          "when": "phoxite.laravel",
          "visibility": "collapsed",
          "icon": "$(symbol-event)",
          "contextualTitle": "Laravel"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "phoxite.laravel.routes",
        "contents": "No routes were found yet. They show once the project is indexed.\n[Refresh](command:phoxite.laravel.routes.refresh)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "phoxite.laravel.generate",
          "when": "phoxite.laravel"
        },
        {
          "command": "phoxite.laravel.newModel",
          "when": "phoxite.laravel"
        },
        {
          "command": "phoxite.laravel.modelView",
          "when": "phoxite.laravel"
        },
        {
          "command": "phoxite.laravel.artisan",
          "when": "phoxite.laravel"
        },
        {
          "command": "phoxite.laravel.routes.goto",
          "when": "phoxite.laravel"
        },
        {
          "command": "phoxite.laravel.routes.refresh",
          "when": "phoxite.laravel"
        },
        {
          "command": "phoxite.laravel.editTemplate",
          "when": "phoxite.laravel"
        },
        {
          "command": "phoxite.laravel.route.goto",
          "when": "false"
        },
        {
          "command": "phoxite.laravel.route.copyUrl",
          "when": "false"
        },
        {
          "command": "phoxite.laravel.route.open",
          "when": "false"
        },
        {
          "command": "phoxite.laravel.route.copyRequest",
          "when": "false"
        },
        {
          "command": "phoxite.laravel.modelView.findUsages",
          "when": "false"
        },
        {
          "command": "phoxite.laravel.modelView.rename",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "phoxite.laravel.generate",
          "when": "phoxite.laravel",
          "group": "navigation@90"
        }
      ],
      "view/title": [
        {
          "command": "phoxite.laravel.routes.refresh",
          "when": "view == phoxite.laravel.routes",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "phoxite.laravel.route.copyUrl",
          "when": "view == phoxite.laravel.routes && viewItem == route",
          "group": "inline@1"
        },
        {
          "command": "phoxite.laravel.route.open",
          "when": "view == phoxite.laravel.routes && viewItem == route",
          "group": "inline@2"
        },
        {
          "command": "phoxite.laravel.route.goto",
          "when": "view == phoxite.laravel.routes && viewItem == route",
          "group": "1_route@1"
        },
        {
          "command": "phoxite.laravel.route.copyUrl",
          "when": "view == phoxite.laravel.routes && viewItem == route",
          "group": "2_url@1"
        },
        {
          "command": "phoxite.laravel.route.open",
          "when": "view == phoxite.laravel.routes && viewItem == route",
          "group": "2_url@2"
        },
        {
          "command": "phoxite.laravel.route.copyRequest",
          "when": "view == phoxite.laravel.routes && viewItem == route",
          "group": "2_url@3"
        }
      ],
      "webview/context": [
        {
          "command": "phoxite.laravel.modelView.findUsages",
          "when": "webviewId == 'phoxite.modelView' && webviewSection == 'item'",
          "group": "1_item@1"
        },
        {
          "command": "phoxite.laravel.modelView.rename",
          "when": "webviewId == 'phoxite.modelView' && webviewSection == 'item' && renamable",
          "group": "1_item@2"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "artisan",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The Artisan command, e.g. migrate or queue:work."
          },
          "arguments": {
            "type": "string",
            "description": "Its arguments and options, e.g. --seed --force."
          }
        }
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test --experimental-strip-types test/*.test.mts",
    "package": "vsce package",
    "vscode:prepublish": "npm run build -- --minify",
    "test:e2e": "npm run build && node test/e2e/run.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
