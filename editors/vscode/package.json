{
  "name": "phoxite",
  "displayName": "Phoxite — PHP & Laravel IntelliSense",
  "description": "PHP and Laravel code intelligence: completion, navigation, usages, rename, refactorings, formatting, inspections and Laravel support (routes, views, config, translations, validation, Eloquent, Blade, generators, Artisan).",
  "version": "0.6.1",
  "publisher": "phoxite",
  "license": "Apache-2.0",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/samehelhawary/phoxite",
    "directory": "editors/vscode"
  },
  "homepage": "https://github.com/samehelhawary/phoxite#readme",
  "bugs": {
    "url": "https://github.com/samehelhawary/phoxite/issues"
  },
  "qna": "https://github.com/samehelhawary/phoxite/issues",
  "galleryBanner": {
    "color": "#312E81",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "php",
    "laravel",
    "blade",
    "intellisense",
    "refactoring",
    "language server",
    "eloquent",
    "artisan",
    "formatter",
    "phpstan",
    "psalm",
    "livewire",
    "inertia"
  ],
  "activationEvents": [
    "onLanguage:php",
    "onLanguage:blade",
    "workspaceContains:composer.json",
    "onWebviewPanel:phoxite.modelView",
    "onWebviewPanel:phoxite.newModel",
    "onWebviewPanel:phoxite.changeSignature"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode Phoxite gives code intelligence from the files it reads. It runs nothing of the project: Artisan, PHPStan and Psalm stay off, and the settings that name a program or a file outside the project are taken from your own settings only.",
      "restrictedConfigurations": [
        "phoxite.server.path",
        "phoxite.analyzers.phpPath",
        "phoxite.analyzers.onSave",
        "phoxite.laravel.artisanCommand",
        "phoxite.laravel.database",
        "phoxite.includePaths"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "The language server reads the project's PHP files from disk."
    }
  },
  "main": "./dist/extension.js",
  "contributes": {
    "configurationDefaults": {
      "php.suggest.basic": false,
      "php.validate.enable": false
    },
    "languages": [
      {
        "id": "blade",
        "aliases": [
          "Blade",
          "blade"
        ],
        "extensions": [
          ".blade.php"
        ],
        "configuration": "./languages/blade.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "blade",
        "scopeName": "text.html.php.blade",
        "path": "./syntaxes/blade.tmLanguage.json",
        "embeddedLanguages": {
          "source.php": "php",
          "text.html.basic": "html",
          "source.css": "css",
          "source.js": "javascript"
        }
      }
    ],
    "jsonValidation": [
      {
        "fileMatch": "phoxite.json",
        "url": "./schemas/phoxite.schema.json"
      },
      {
        "fileMatch": "ide.json",
        "url": "./schemas/laravel-ide-json.json"
      }
    ],
    "snippets": [
      {
        "language": "blade",
        "path": "./snippets/blade.json"
      }
    ],
    "commands": [
      {
        "command": "phoxite.restart",
        "title": "Restart the Language Server",
        "category": "Phoxite"
      },
      {
        "command": "phoxite.showLog",
        "title": "Show the Server Log",
        "category": "Phoxite"
      },
      {
        "command": "phoxite.rescan",
        "title": "Index the Project Again",
        "category": "Phoxite"
      },
      {
        "command": "phoxite.showOutput",
        "title": "Show the Server Log",
        "category": "Phoxite"
      },
      {
        "command": "phoxite.status",
        "title": "Server Status and Actions",
        "category": "Phoxite"
      },
      {
        "command": "phoxite.refactor.changeSignature",
        "title": "Change Signature…",
        "category": "Phoxite"
      },
      {
        "command": "phoxite.refactor.pullMembersUp",
        "title": "Pull Members Up…",
        "category": "Phoxite"
      },
      {
        "command": "phoxite.refactor.pushMembersDown",
        "title": "Push Members Down…",
        "category": "Phoxite"
      },
      {
        "command": "phoxite.laravel.generate",
        "title": "Generate…",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.newModel",
        "title": "New Eloquent Model…",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.modelView",
        "title": "Open Model View…",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.artisan",
        "title": "Run Artisan Command…",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.artisanLast",
        "title": "Run Last Artisan Command",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.routes.goto",
        "title": "Go to Route…",
        "category": "Laravel",
        "icon": "$(search)"
      },
      {
        "command": "phoxite.laravel.routes.refresh",
        "title": "Refresh Routes",
        "category": "Laravel",
        "icon": "$(refresh)"
      },
      {
        "command": "phoxite.laravel.routes.filter",
        "title": "Filter Routes…",
        "category": "Laravel",
        "icon": "$(filter)"
      },
      {
        "command": "phoxite.laravel.routes.clearFilter",
        "title": "Clear the Routes Filter",
        "category": "Laravel",
        "icon": "$(clear-all)"
      },
      {
        "command": "phoxite.laravel.editTemplate",
        "title": "Edit Generator Template…",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.refreshSchema",
        "title": "Read the Database Schema Again",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.route.goto",
        "title": "Go to Declaration",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.route.copyUrl",
        "title": "Copy URL",
        "category": "Laravel",
        "icon": "$(link)"
      },
      {
        "command": "phoxite.laravel.route.open",
        "title": "Open in Browser",
        "category": "Laravel",
        "icon": "$(globe)"
      },
      {
        "command": "phoxite.laravel.route.copyRequest",
        "title": "Copy HTTP Request",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.modelView.findUsages",
        "title": "Find Usages",
        "category": "Laravel"
      },
      {
        "command": "phoxite.laravel.modelView.rename",
        "title": "Rename…",
        "category": "Laravel"
      }
    ],
    "configuration": {
      "title": "Phoxite",
      "properties": {
        "phoxite.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The `phoxite-lsp` executable. Empty: the one bundled with the extension."
        },
        "phoxite.server.logLevel": {
          "type": "string",
          "enum": [
            "error",
            "warn",
            "info",
            "debug",
            "trace"
          ],
          "default": "info",
          "scope": "machine-overridable",
          "markdownDescription": "How much the language server writes to its log (**Phoxite: Show the Server Log**). Takes effect when the server is restarted."
        },
        "phoxite.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "enumDescriptions": [
            "Nothing.",
            "The name of each request and notification.",
            "Each request and notification with its content."
          ],
          "default": "off",
          "scope": "window",
          "markdownDescription": "Writes what the extension and the language server say to each other to the log. For reporting a problem."
        },
        "phoxite.phpVersion": {
          "type": "string",
          "default": "",
          "markdownDescription": "The PHP version the code is checked against, e.g. `8.3`. Empty: from `composer.json` (`config.platform.php`, else the lowest version `require.php` allows), else the latest."
        },
        "phoxite.includePaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Folders outside the project whose code is indexed too: absolute, `~/…`, or relative to the project. A `composer.json` at the top of such a folder is read for what it autoloads, and so is the one beside a Composer `vendor` folder."
        },
        "phoxite.stubs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra phpstorm-stubs sets (`redis`, `swoole`, `wordpress`…) on top of the defaults and the `ext-*` requirements of `composer.json`."
        },
        "phoxite.exclude": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          },
          "default": null,
          "markdownDescription": "Globs of files and folders left out of the index (`node_modules`, `/storage`). `null`: `node_modules`, `.git`, `storage/framework` and `bootstrap/cache`. `vendor` is read through Composer's `installed.json` either way."
        },
        "phoxite.inspections": {
          "type": "object",
          "default": {},
          "markdownDescription": "Per-inspection settings by id, e.g. `{ \"PhpUndefinedMethod\": { \"enabled\": false }, \"PhpTypeMismatch\": { \"strict\": true, \"severity\": \"error\" } }`. The key `*` with `enabled: false` turns every inspection off.",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "strict": {
                "type": "boolean",
                "description": "Type and call checks: also report what can't be proven."
              },
              "severity": {
                "type": "string",
                "enum": [
                  "error",
                  "warning",
                  "information",
                  "hint"
                ]
              }
            }
          }
        },
        "phoxite.laravel.detection": {
          "type": "string",
          "enum": [
            "auto",
            "enabled",
            "disabled"
          ],
          "default": "auto",
          "markdownDescription": "Laravel support: `auto` when `composer.json` requires `laravel/framework`, the lock file lists it, or `artisan` exists.",
          "markdownEnumDescriptions": [
            "A project is a Laravel one when `composer.json` requires `laravel/framework`, the lock file lists it, or `artisan` exists.",
            "Every project is treated as a Laravel one.",
            "No Laravel support."
          ]
        },
        "phoxite.laravel.routeHints": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Code lenses on controller methods listing their routes, and the full URI after each route registration."
        },
        "phoxite.laravel.modules": {
          "type": "string",
          "enum": [
            "auto",
            "nwidart",
            "directory",
            "none"
          ],
          "default": "auto",
          "markdownDescription": "Which modules of a modular application are read: `nwidart/laravel-modules`, module folders (`modules/`, `app-modules/`…), both (`auto`), or none.",
          "markdownEnumDescriptions": [
            "`nwidart/laravel-modules` and module folders.",
            "Only the modules of `nwidart/laravel-modules`.",
            "Only module folders (`modules/`, `app-modules/`…).",
            "No modules."
          ]
        },
        "phoxite.laravel.inertiaPages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Folders of Inertia pages, relative to the project. Empty: the `ide.json` page paths, else `resources/js/Pages`."
        },
        "phoxite.laravel.database": {
          "type": "string",
          "default": "",
          "scope": "window",
          "markdownDescription": "A SQLite database whose tables and columns Phoxite reads, read-only, along with the migrations (the database wins): `auto` for the one the project's `.env` names (`DB_CONNECTION=sqlite`), or the file's path relative to the project. Empty: the migrations alone."
        },
        "phoxite.laravel.artisanCommand": {
          "type": "string",
          "default": "php artisan",
          "scope": "resource",
          "markdownDescription": "How Artisan commands are run from the project folder, e.g. `php artisan`, `./vendor/bin/sail artisan` or `docker compose exec app php artisan`."
        },
        "phoxite.laravel.generation.namespace": {
          "type": "string",
          "default": "",
          "markdownDescription": "The application's root namespace for generated classes. Empty: the one `composer.json` maps to `app/`."
        },
        "phoxite.laravel.generation.module": {
          "type": "string",
          "default": "",
          "markdownDescription": "The module generated classes go to. Empty: the application."
        },
        "phoxite.laravel.generation.controllerSuffix": {
          "type": "string",
          "default": "Controller",
          "markdownDescription": "The suffix of generated controller classes."
        },
        "phoxite.laravel.generation.requestSuffix": {
          "type": "string",
          "default": "Request",
          "markdownDescription": "The suffix of generated request classes."
        },
        "phoxite.laravel.generation.resourceSuffix": {
          "type": "string",
          "default": "Resource",
          "markdownDescription": "The suffix of generated resource classes."
        },
        "phoxite.laravel.generation.policySuffix": {
          "type": "string",
          "default": "Policy",
          "markdownDescription": "The suffix of generated policy classes."
        },
        "phoxite.laravel.generation.seederSuffix": {
          "type": "string",
          "default": "Seeder",
          "markdownDescription": "The suffix of generated seeder classes."
        },
        "phoxite.laravel.generation.constructorPromotion": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Generated constructors promote their parameters to properties."
        },
        "phoxite.laravel.generation.typeHints": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Generated methods declare their return types."
        },
        "phoxite.format.lineWidth": {
          "type": "integer",
          "default": 120,
          "minimum": 40,
          "markdownDescription": "The line length Format Document tries to stay within."
        },
        "phoxite.format.tool": {
          "type": "string",
          "enum": [
            "phoxite",
            "pint"
          ],
          "default": "phoxite",
          "scope": "window",
          "markdownDescription": "What **Format Document** uses for a PHP file. A selection, and Blade files, are always formatted by Phoxite.",
          "markdownEnumDescriptions": [
            "Phoxite's own formatter (PSR-12). Needs nothing installed.",
            "The project's Laravel Pint (`vendor/bin/pint`, with its `pint.json`), run with the PHP of `phoxite.analyzers.phpPath`. Only in a trusted workspace; when the project doesn't install Pint, or Pint fails, Phoxite's formatter is used."
          ]
        },
        "phoxite.analyzers.onSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run PHPStan and Psalm on each PHP file you save, when the project installs them (`vendor/bin/phpstan`, `vendor/bin/psalm` with a `psalm.xml`). Their problems show next to Phoxite's own, without those Phoxite already reports."
        },
        "phoxite.analyzers.phpPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "The PHP interpreter that runs PHPStan and Psalm. Empty: `php` on your `PATH`."
        },
        "phoxite.templates.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "The folder of the generator templates you edited (**Laravel: Edit Generator Template…**), relative to the project. Empty: `.phoxite/templates`."
        },
        "phoxite.warnAboutOtherServers": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Warn when another extension answers the same requests: a PHP language server (Intelephense, PHP IntelliSense, Phpactor, DEVSENSE PHP), a Laravel extension that completes the same names, or one that defines the Blade language too."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "phoxite.laravel.routes",
          "name": "Laravel Routes",
          "when": "phoxite.laravel",
          "visibility": "collapsed",
          "icon": "$(symbol-event)",
          "contextualTitle": "Laravel"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "phoxite.laravel.routes",
        "when": "phoxite.laravel.routes.state == failed",
        "contents": "The routes couldn't be read from the language server.\n[Restart the Language Server](command:phoxite.restart)\n[Show the Server Log](command:phoxite.showLog)"
      },
      {
        "view": "phoxite.laravel.routes",
        "when": "phoxite.laravel.routes.state == filtered",
        "contents": "No route matches the filter.\n[Clear the Filter](command:phoxite.laravel.routes.clearFilter)"
      },
      {
        "view": "phoxite.laravel.routes",
        "when": "phoxite.laravel.routes.state == empty",
        "contents": "This project declares no routes yet. They are read from the files of `routes/` and from the providers that register them.\n[Refresh](command:phoxite.laravel.routes.refresh)"
      }
    ],
    "submenus": [
      {
        "id": "phoxite.refactor",
        "label": "PHP Refactorings"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "phoxite.refactor.changeSignature",
          "when": "editorLangId == php"
        },
        {
          "command": "phoxite.refactor.pullMembersUp",
          "when": "editorLangId == php"
        },
        {
          "command": "phoxite.refactor.pushMembersDown",
          "when": "editorLangId == php"
        },
        {
          "command": "phoxite.laravel.generate",
          "when": "phoxite.laravel"
        },
        {
          "command": "phoxite.laravel.newModel",
          "when": "phoxite.laravel"
        },
        {
          "command": "phoxite.laravel.modelView",
          "when": "phoxite.laravel"
        },
        {
          "command": "phoxite.laravel.artisan",
          "when": "phoxite.laravel"
        },
        {
          "command": "phoxite.laravel.routes.goto",
          "when": "phoxite.laravel"
        },
        {
          "command": "phoxite.laravel.routes.refresh",
          "when": "phoxite.laravel"
        },
        {
          "command": "phoxite.laravel.editTemplate",
          "when": "phoxite.laravel"
        },
        {
          "command": "phoxite.laravel.refreshSchema",
          "when": "phoxite.laravel"
        },
        {
          "command": "phoxite.laravel.route.goto",
          "when": "false"
        },
        {
          "command": "phoxite.laravel.route.copyUrl",
          "when": "false"
        },
        {
          "command": "phoxite.laravel.route.open",
          "when": "false"
        },
        {
          "command": "phoxite.laravel.route.copyRequest",
          "when": "false"
        },
        {
          "command": "phoxite.laravel.modelView.findUsages",
          "when": "false"
        },
        {
          "command": "phoxite.laravel.modelView.rename",
          "when": "false"
        },
        {
          "command": "phoxite.laravel.routes.filter",
          "when": "phoxite.laravel"
        },
        {
          "command": "phoxite.laravel.routes.clearFilter",
          "when": "phoxite.laravel && phoxite.laravel.routes.filter"
        },
        {
          "command": "phoxite.laravel.artisanLast",
          "when": "phoxite.laravel"
        }
      ],
      "editor/context": [
        {
          "submenu": "phoxite.refactor",
          "when": "editorLangId == php",
          "group": "1_modification@90"
        }
      ],
      "phoxite.refactor": [
        {
          "command": "phoxite.refactor.changeSignature",
          "group": "1_refactor@1"
        },
        {
          "command": "phoxite.refactor.pullMembersUp",
          "group": "1_refactor@2"
        },
        {
          "command": "phoxite.refactor.pushMembersDown",
          "group": "1_refactor@3"
        }
      ],
      "explorer/context": [
        {
          "command": "phoxite.laravel.generate",
          "when": "phoxite.laravel",
          "group": "navigation@90"
        }
      ],
      "view/title": [
        {
          "command": "phoxite.laravel.routes.goto",
          "when": "view == phoxite.laravel.routes",
          "group": "navigation@1"
        },
        {
          "command": "phoxite.laravel.routes.filter",
          "when": "view == phoxite.laravel.routes",
          "group": "navigation@2"
        },
        {
          "command": "phoxite.laravel.routes.clearFilter",
          "when": "view == phoxite.laravel.routes && phoxite.laravel.routes.filter",
          "group": "navigation@3"
        },
        {
          "command": "phoxite.laravel.routes.refresh",
          "when": "view == phoxite.laravel.routes",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "phoxite.laravel.route.copyUrl",
          "when": "view == phoxite.laravel.routes && viewItem == route",
          "group": "inline@1"
        },
        {
          "command": "phoxite.laravel.route.open",
          "when": "view == phoxite.laravel.routes && viewItem == route",
          "group": "inline@2"
        },
        {
          "command": "phoxite.laravel.route.goto",
          "when": "view == phoxite.laravel.routes && viewItem == route",
          "group": "1_route@1"
        },
        {
          "command": "phoxite.laravel.route.copyUrl",
          "when": "view == phoxite.laravel.routes && viewItem == route",
          "group": "2_url@1"
        },
        {
          "command": "phoxite.laravel.route.open",
          "when": "view == phoxite.laravel.routes && viewItem == route",
          "group": "2_url@2"
        },
        {
          "command": "phoxite.laravel.route.copyRequest",
          "when": "view == phoxite.laravel.routes && viewItem == route",
          "group": "2_url@3"
        }
      ],
      "webview/context": [
        {
          "command": "phoxite.laravel.modelView.findUsages",
          "when": "webviewId == 'phoxite.modelView' && webviewSection == 'item'",
          "group": "1_item@1"
        },
        {
          "command": "phoxite.laravel.modelView.rename",
          "when": "webviewId == 'phoxite.modelView' && webviewSection == 'item' && renamable",
          "group": "1_item@2"
        }
      ]
    },
    "taskDefinitions": [
      {
        "type": "artisan",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "The Artisan command, e.g. migrate or queue:work."
          },
          "arguments": {
            "type": "string",
            "description": "Its arguments and options, e.g. --seed --force."
          }
        }
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --target=node18 --sourcemap",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npm run build && node --test --experimental-strip-types test/*.test.mts",
    "package": "node ../../scripts/package_vscode.mjs",
    "vscode:prepublish": "npm run build -- --minify",
    "test:e2e": "npm run build && node test/e2e/run.js",
    "screenshots": "npm run build && node test/screenshots/run.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
